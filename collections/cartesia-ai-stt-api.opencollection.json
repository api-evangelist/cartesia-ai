{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cartesia Auth STT API",
    "version": "2024-11-13"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "STT",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Batch transcribe audio with the Ink model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cartesia.ai/stt/transcribe",
            "headers": [
              {
                "name": "Cartesia-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "model",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "language",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "timestamp_granularities",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Batch transcribe audio with the Ink model"
        }
      ]
    }
  ],
  "bundled": true
}