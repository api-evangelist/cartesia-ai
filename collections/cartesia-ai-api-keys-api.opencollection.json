{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cartesia Agents API Keys API",
    "version": "2026-03-01"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cartesia.ai/api-keys",
            "headers": [
              {
                "name": "Cartesia-Version",
                "value": ""
              }
            ]
          },
          "docs": "Returns a paginated list of standard API keys."
        },
        {
          "info": {
            "name": "Get API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cartesia.ai/api-keys/:id",
            "headers": [
              {
                "name": "Cartesia-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns metadata for a single API key."
        }
      ]
    }
  ],
  "bundled": true
}