{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cartesia Agents Deployments API",
    "version": "2026-03-01"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Deployments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Deployments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cartesia.ai/deployments",
            "headers": [
              {
                "name": "Cartesia-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List of all deployments associated with an agent."
        },
        {
          "info": {
            "name": "Get Deployment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cartesia.ai/deployments/:id",
            "headers": [
              {
                "name": "Cartesia-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Deployment"
        }
      ]
    }
  ],
  "bundled": true
}